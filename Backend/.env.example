# Serveur
PORT=3001
NODE_ENV=development

# Base de données (Prisma + legacy pool optionnel)
DATABASE_URL="postgresql://user:password@localhost:5432/mtn_ussd"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sécurité (JWT legacy + API v1)
JWT_SECRET=your-256-bit-secret-change-me
PIN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Firebase FCM (optionnel)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Modems GSM (JSON par variable)
MODEM_0={"portPath":"/dev/ttyUSB0","country":"BJ","simNumber":"22961000000"}

# Mock modem (développement)
USE_MOCK_MODEM=true
MOCK_FAILURE_RATE=0

# Timeouts (ms)
USSD_COMMAND_TIMEOUT=5000
USSD_STEP_TIMEOUT=25000
USSD_SESSION_TIMEOUT=90000

# Queue
MAX_RETRY_ATTEMPTS=3
JOB_TIMEOUT=120000
HEALTHCHECK_INTERVAL=60000
MODEM_ACQUIRE_TIMEOUT_MS=30000
