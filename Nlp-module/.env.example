# ========================================
# 🎙️ VoiceMomo AI Backend Configuration
# ========================================

# === AUTHENTIFICATION ===
# Secret key pour les tokens JWT (CHANGE EN PRODUCTION!)
JWT_SECRET=your-super-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === API ===
# URL du backend NLP (utilisé par le frontend)
NLP_API_URL=http://localhost:8000
NLP_API_HOST=0.0.0.0
NLP_API_PORT=8000

# === GEMINI API ===
# Clé API Google Gemini (obligatoire pour la reconnaissance vocale)
GEMINI_API_KEY=your-gemini-api-key-here

# Modèle Gemini à utiliser
GEMINI_MODEL=gemini-2.0-flash

# === BASE DE DONNÉES ===
# Mode persistence: "true" = PostgreSQL, "false" = in-memory (dev)
USE_POSTGRES=false

# PostgreSQL URL (si USE_POSTGRES=true)
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_momo

# === RATE LIMITING ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30

# === LOGGING ===
LOG_LEVEL=INFO

# === FEATURES ===
ENABLE_TEST_TOKEN_ENDPOINT=true
TRANSACTION_TTL_SECONDS=300

# === DÉVELOPPEMENT ===
DEBUG=false
ALLOW_UNAUTHENTICATED=true
