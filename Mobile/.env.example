# Backend API (Voice MoMo)
VITE_API_BASE_URL=http://localhost:3001

# NLP Module (Voice AI) - FastAPI service with Gemini 2.0 Flash
# Port 8000 = NLP Module (STT+NLU+TTS)
# Use your PC LAN IP when testing on a device (same Wi‑Fi).
VITE_VOICE_AI_URL=http://192.168.100.35:8000

# ===== MICROPHONE TIMEOUT CONFIGURATION =====
# Silence duration (in milliseconds) before auto-stopping microphone
# Default: 2000ms (2 seconds)
# Increase if users speak too slowly, decrease for faster response
VITE_SILENCE_DURATION_MS=2000

# Silence detection threshold (RMS - Root Mean Square)
# Lower value = more sensitive to small sounds and background noise
# Higher value = only loud sounds trigger, might miss quiet speech
# Range: 0.01 - 0.1
# Default: 0.02
VITE_SILENCE_THRESHOLD=0.02

# Maximum recording duration (in milliseconds) before force-stopping
# Default: 30000ms (30 seconds)
# Prevents infinite recording if silence detection fails
VITE_MAX_RECORDING_TIME_MS=30000
