# Serveur
PORT=3001
NODE_ENV=development

# Base de données (Prisma + legacy pool optionnel)
DATABASE_URL="postgresql://user:password@localhost:5432/mtn_ussd"

# Redis (BullMQ) — en local : npm run dev:redis  (depuis Backend/)
# Sans Redis : SKIP_REDIS=true (API legacy /auth /users /transactions /voice /mmi uniquement)
SKIP_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sécurité (JWT legacy + API v1)
JWT_SECRET=your-256-bit-secret-change-me
PIN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Connexion par OTP (API legacy) : un fournisseur SMS est requis en production, sinon l'envoi échoue (503).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# ou Termii : SMS_API_KEY=  (optionnel : SMS_PROVIDER_URL, SMS_SENDER_ID)
# DEFAULT_COUNTRY_CODE=229

# Comportements de développement de l'OTP : accepte le code 000000 et renvoie le code dans la réponse
# quand le SMS échoue. NE JAMAIS activer en production.
ALLOW_DEV_OTP=false

# Firebase FCM (optionnel)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Modems GSM (JSON par variable)
MODEM_0={"portPath":"/dev/ttyUSB0","country":"BJ","simNumber":"22961000000"}

# Mock modem (développement)
USE_MOCK_MODEM=true
MOCK_FAILURE_RATE=0

# Timeouts (ms)
USSD_COMMAND_TIMEOUT=5000
USSD_STEP_TIMEOUT=25000
USSD_SESSION_TIMEOUT=90000

# Queue
MAX_RETRY_ATTEMPTS=3
JOB_TIMEOUT=120000
HEALTHCHECK_INTERVAL=60000
MODEM_ACQUIRE_TIMEOUT_MS=30000
