# ========================================
# 🎙️ VoiceMomo AI Backend Configuration
# ========================================

# === AUTHENTIFICATION ===
# Secret des tokens JWT : OBLIGATOIRE (le service refuse de démarrer sans), et identique à celui du
# backend qui émet les jetons. Générer une valeur aléatoire ; ne jamais réutiliser cet exemple.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === API ===
# URL du backend NLP (utilisé par le frontend)
NLP_API_URL=http://localhost:8000
NLP_API_HOST=0.0.0.0
NLP_API_PORT=8000

# === GEMINI API ===
# Clé API Google Gemini (obligatoire pour la reconnaissance vocale)
GEMINI_API_KEY=your-gemini-api-key-here

# Version API: "v1beta" pour Gemini (standard), "v1" pour Vertex AI
GEMINI_API_VERSION=v1beta

# Modèle Gemini à utiliser
# Options: gemini-flash-latest (recommandé), gemini-flash-lite-latest, gemini-pro-latest
# Note: gemini-2.0-flash et gemini-1.5-flash ne sont plus disponibles
GEMINI_MODEL=gemini-flash-latest

# === BASE DE DONNÉES ===
# Mode persistence: "true" = PostgreSQL, "false" = in-memory (dev)
USE_POSTGRES=false

# PostgreSQL URL (si USE_POSTGRES=true)
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_momo

# === RATE LIMITING ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=30

# === LOGGING ===
LOG_LEVEL=INFO

# === FEATURES ===
# Endpoints de test (/api/auth/token|login|register, /api/users/profile|balance, /api/transactions) :
# émettent des jetons sans identifiants ou exposent des données par user_id. Développement local
# uniquement — NE JAMAIS activer en production.
ENABLE_TEST_ENDPOINTS=false
TRANSACTION_TTL_SECONDS=300

# === DÉVELOPPEMENT ===
DEBUG=false
